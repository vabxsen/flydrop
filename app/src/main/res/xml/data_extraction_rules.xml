<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Excludes avatars left in filesDir by releases before noBackupFilesDir. -->
        <exclude domain="file" path="avatars/" />
        <!-- Contact provider IDs are device-local and must never restore elsewhere. -->
        <exclude domain="sharedpref" path="flydrop_home.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="avatars/" />
        <exclude domain="sharedpref" path="flydrop_home.xml" />
    </device-transfer>
</data-extraction-rules>
