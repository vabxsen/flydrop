<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Excludes avatars left in filesDir by releases before noBackupFilesDir. -->
        <exclude domain="file" path="avatars/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="avatars/" />
    </device-transfer>
</data-extraction-rules>
